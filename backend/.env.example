# Copy to .env and adjust. Never commit the real .env.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_bus_tracking

# Redis holds the latest GPS fix per active bus. Leave empty to use the in-memory fallback (local dev only).
REDIS_URL=redis://127.0.0.1:6379

# Signs login tokens. Use a long random value in any shared or deployed environment.
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created only when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated list of allowed web origins. Leave empty to allow all (local dev only).
CORS_ORIGIN=

# Optional: routing server used by `npm run seed` to draw the demo route. Defaults to the public OSRM demo server.
# OSRM_URL=https://router.project-osrm.org/route/v1/driving
