{
  "expo": {
    "name": "SmartBus Driver",
    "slug": "driver-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "lk.smartbus.driver",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow the driver app to share live bus location while on duty.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow the driver app to share the live bus location while on duty, including when the screen is off.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#130E0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "lk.smartbus.driver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/notification-icon.png",
          "locationAlwaysAndWhenInUsePermission": "Allow SmartBus Driver to share the live bus location while on duty."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "nadunkanishka",
    "extra": {
      "eas": {
        "projectId": "29e7f2a7-a96a-498c-a2ac-6c38ec75b27e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/29e7f2a7-a96a-498c-a2ac-6c38ec75b27e"
    }
  }
}
