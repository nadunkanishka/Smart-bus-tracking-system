# Copy to .env. Use your computer's LAN IP so a real phone can reach the backend.
EXPO_PUBLIC_API_URL=http://192.168.1.20:5000
EXPO_PUBLIC_DISPATCH_PHONE=+94 11 248 7700

# Optional: Google Maps key for native builds (read by app.config.js). Not needed in Expo Go or the browser.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
