{
  "expo": {
    "name": "SmartBus Passenger",
    "slug": "passenger-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "lk.smartbus.passenger",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow the passenger app to show your location on the live bus map."
      }
    },
    "android": {
      "package": "lk.smartbus.passenger",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "nadunkanishka",
    "extra": {
      "eas": {
        "projectId": "fa4788ab-d1be-4c86-9ee2-cb897a364890"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fa4788ab-d1be-4c86-9ee2-cb897a364890"
    }
  }
}
