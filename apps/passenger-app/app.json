{
  "expo": {
    "name": "SmartBus Passenger",
    "slug": "passenger-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "lk.smartbus.passenger",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow the passenger app to show your location on the live bus map."
      }
    },
    "android": {
      "package": "lk.smartbus.passenger",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "86e46836-e73f-4ce2-ac14-28fca0189c3b"
      }
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
